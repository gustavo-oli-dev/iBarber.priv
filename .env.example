# Copie para .env e preencha. O run.bat gera este arquivo automaticamente
# com valores de desenvolvimento na primeira execução.

# ── Obrigatórias (a aplicação não sobe sem elas) ─────────────────────────────
SECRET_KEY=                 # segredo do Flask; assina sessão e tokens da API
DATABASE_URL=               # local:     sqlite:///ibarber.db
                            # produção:  mysql+pymysql://user:senha@host/ibarber
API_TOKEN=                  # chave mestra do painel admin — mínimo 32 caracteres
MAIL_USER=                  # conta SMTP (Gmail: use senha de app)
MAIL_PASSWORD=
MAIL_FROM=                  # remetente exibido nos e-mails

# ── Pagamentos (Mercado Pago) ────────────────────────────────────────────────
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=          # sem isto o webhook rejeita todas as notificações

# ── Domínio e CORS ───────────────────────────────────────────────────────────
APP_DOMAIN=ibarber.shop
APP_BASE_URL=https://ibarber.shop
CORS_ORIGINS=               # lista separada por vírgula; vazio usa a allowlist padrão

# ── Login com Google (opcional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ibarber.shop/auth/google/callback

# ── Provisionamento de subdomínio (VPS com root) ─────────────────────────────
# Usado por _provisionar_ssl_tenant: cria o DNS na Cloudflare, emite o
# certificado com certbot e registra o vhost no nginx.
CF_TOKEN=                   # token da API Cloudflare
CF_ZONE_ID=
VPS_IP=                     # IP de destino do registro A

# ── Operação ─────────────────────────────────────────────────────────────────
REDIS_URL=                  # ex.: redis://127.0.0.1:6379/1 — sem isto o rate
                            # limit é por worker do gunicorn (e some no restart)
RUN_SCHEDULER=0             # 1 APENAS no processo dedicado aos jobs periódicos;
                            # se ficar 1 em todo worker, cada job roda N vezes
TOKEN_TTL_HORAS=12          # validade dos tokens da API
FLASK_DEBUG=0               # 1 em desenvolvimento (recarrega e libera o scheduler)
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
