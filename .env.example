# ── Obrigatórias (a aplicação não sobe sem elas) ─────────────────────────────
SECRET_KEY=                 # segredo do Flask; assina sessão e tokens da API
DATABASE_URL=               # Postgres: postgresql://user:senha@host/ibarber
                            # (o prefixo postgres:// do Render é normalizado no boot)
API_TOKEN=                  # chave mestra do painel admin — mínimo 32 caracteres
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=                  # remetente dos e-mails; era exigido mas não estava aqui

# ── Pagamentos (Mercado Pago) ────────────────────────────────────────────────
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=          # sem isto o webhook rejeita todas as notificações

# ── Domínio e CORS ───────────────────────────────────────────────────────────
APP_DOMAIN=ibarber.shop
APP_BASE_URL=https://ibarber.shop
CORS_ORIGINS=               # lista separada por vírgula; vazio usa a allowlist padrão

# ── Login com Google (opcional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ibarber.shop/auth/google/callback

# ── Provisionamento de subdomínio (opcional) ─────────────────────────────────
# O TLS de *.APP_DOMAIN é emitido pela plataforma (domínio wildcard no Render);
# aqui só se cria o registro DNS de cada barbearia nova.
CF_TOKEN=                   # token da API Cloudflare
CF_ZONE_ID=
CNAME_ALVO=                 # ex.: ibarber.onrender.com — alvo do CNAME dos tenants
VPS_IP=                     # legado: só usado se CNAME_ALVO estiver vazio

# ── Operação ─────────────────────────────────────────────────────────────────
REDIS_URL=                  # ex.: redis://127.0.0.1:6379/1 — sem isto o rate
                            # limit é por worker do gunicorn (e some no deploy)
RUN_SCHEDULER=0             # 1 APENAS no processo dedicado aos jobs periódicos;
                            # se ficar 1 em todo worker, cada job roda N vezes
TOKEN_TTL_HORAS=12          # validade dos tokens da API
FLASK_DEBUG=0
WEB_CONCURRENCY=2           # workers do gunicorn

# ATENÇÃO: em container o filesystem é EFÊMERO. Sem apontar para um disco
# persistente, toda imagem enviada (fotos de funcionários, produtos, serviços,
# logos) some no próximo deploy.
UPLOAD_FOLDER=              # vazio = ./static/uploads ; produção: /var/data/uploads
